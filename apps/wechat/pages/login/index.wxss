.login-page {
  min-height: 100vh;
  padding: 74rpx 36rpx 44rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #0d5c63 0%, #11373b 62%, #0c2d31 100%);
  color: #ffffff;
}

.brand-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efc47f;
  color: #173437;
  font-size: 48rpx;
  font-weight: 800;
}

.eyebrow {
  display: block;
  color: #b9e5da;
  margin-top: 38rpx;
}

.title {
  display: block;
  font-size: 84rpx;
  line-height: 1.05;
  letter-spacing: -6rpx;
  font-weight: 800;
  margin: 18rpx 0;
}

.subtitle {
  display: block;
  color: #d8efea;
  font-size: 30rpx;
  line-height: 1.7;
}

.login-card {
  color: #173437;
  margin-top: 48rpx;
}

.card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.role-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.role-chip {
  margin: 0;
  flex: 1;
  border: 1rpx solid #d8e4e1;
  background: #fbfdfc;
  color: #446064;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 70rpx;
}

.role-chip.selected {
  border-color: #0d5c63;
  color: #0d5c63;
  background: #e5f2f0;
  font-weight: 700;
}

.field-label {
  display: block;
  color: #5d7376;
  font-size: 24rpx;
  font-weight: 600;
  margin: 20rpx 0 10rpx;
}

.field {
  height: 84rpx;
  border: 1rpx solid #c9d9d5;
  border-radius: 16rpx;
  padding: 0 20rpx;
  background: #ffffff;
}

.error {
  display: block;
  color: #a83e32;
  background: #fbebe8;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
}

.primary-button {
  margin-top: 28rpx;
}

.demo-hint {
  display: block;
  color: #788c8f;
  font-size: 22rpx;
  margin-top: 18rpx;
  text-align: center;
}

.boundary {
  display: block;
  color: #a8c9c4;
  font-size: 22rpx;
  line-height: 1.7;
  margin-top: 28rpx;
}
