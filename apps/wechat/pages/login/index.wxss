page { background: #fbfefd; }
.login-page { min-height: 100vh; padding: 64rpx 40rpx 80rpx; display: flex; flex-direction: column; gap: 36rpx; }
.brand { display: flex; flex-direction: column; gap: 10rpx; }
.brand-mark { width: 72rpx; height: 72rpx; border-radius: 24rpx; background: linear-gradient(135deg, #9be3cf, #b9e6f7); color: #2c5f53; display: grid; place-items: center; font-size: 36rpx; font-weight: 700; }
.brand-title { font-size: 40rpx; font-weight: 700; color: #33454d; }
.brand-note { font-size: 24rpx; color: #7a8f96; }
.role-swiper { height: 300rpx; }
.role-card { height: 280rpx; margin: 0 10rpx; background: #ffffff; border: 2rpx solid #e4f1eb; border-radius: 32rpx; padding: 32rpx; display: flex; flex-direction: column; gap: 8rpx; box-shadow: 0 16rpx 40rpx rgba(124, 203, 179, 0.12); }
.role-icon { font-size: 36rpx; }
.role-title { font-size: 32rpx; font-weight: 700; color: #33454d; }
.role-desc { font-size: 24rpx; color: #7a8f96; }
.account-row { display: flex; gap: 12rpx; margin-top: auto; }
.account-chip { margin: 0; padding: 0 22rpx; height: 56rpx; line-height: 56rpx; font-size: 23rpx; border-radius: 999rpx; background: #eefaf5; color: #4c8a78; border: none; }
.account-chip.active { background: #7ccbb3; color: #ffffff; }
.form-card { background: #ffffff; border: 2rpx solid #e4f1eb; border-radius: 32rpx; padding: 32rpx; display: flex; flex-direction: column; gap: 22rpx; }
.field { display: flex; flex-direction: column; gap: 8rpx; font-size: 24rpx; color: #7a8f96; }
.field input { border: 2rpx solid #e4f1eb; border-radius: 18rpx; padding: 18rpx 22rpx; font-size: 28rpx; color: #33454d; background: #fbfefd; }
.primary-button { border-radius: 999rpx; background: linear-gradient(135deg, #7ccbb3, #9ed8ef); color: #ffffff; font-size: 30rpx; }
.error { color: #d07a75; font-size: 24rpx; }
.hint { font-size: 22rpx; color: #9bb0b5; line-height: 1.6; }
