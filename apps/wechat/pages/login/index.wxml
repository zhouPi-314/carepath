<view class="login-page">
  <view class="brand-mark">医</view>
  <text class="eyebrow">CAREPATH SANDBOX</text>
  <text class="title">医程共护</text>
  <text class="subtitle">把治疗计划、随访任务和家属协同放进同一条可追踪路径。</text>

  <view class="card login-card">
    <text class="card-title">选择演示身份</text>
    <view class="role-row">
      <button
        wx:for="{{accounts}}"
        wx:key="username"
        class="role-chip {{username === item.username ? 'selected' : ''}}"
        data-username="{{item.username}}"
        bindtap="chooseAccount"
      >
        {{item.label}}
      </button>
    </view>

    <text class="field-label">账号</text>
    <input
      class="field"
      value="{{username}}"
      data-field="username"
      bindinput="onInput"
      placeholder="请输入账号"
    />
    <text class="field-label">密码</text>
    <input
      class="field"
      password
      value="{{password}}"
      data-field="password"
      bindinput="onInput"
      placeholder="请输入密码"
    />
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <button
      class="primary-button"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="submit"
    >
      进入医程共护
    </button>
    <text class="demo-hint">演示密码：CarePath123!</text>
  </view>

  <text class="boundary">当前为开发沙箱，使用合成病例；真实微信登录与订阅消息需后续配置 AppID。</text>
</view>
